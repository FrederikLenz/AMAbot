<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AMA</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <div class="ama-app">

        <!-- =================================
             SIDEBAR
        ================================== -->

        <aside class="sidebar">

            <!-- Sidebar header -->
            <header class="sidebar-header">

                <div class="logo">
                    <div class="logo-icon">
                        <!-- AMA icon -->
                    </div>

                    <span class="logo-text">AMA</span>
                </div>

            </header>


            <!-- Host profile -->
            <section class="profile">
                <div class="profile-image-wrapper">
                    <img class="profile-image" src="/images/cæsar.jpg" alt="Profile picture">
                </div>
            </section>


            <!-- New session -->
            <div class="sidebar-footer">

                <button
                    class="new-session-button"
                    type="button"
                >
                    New session
                </button>

            </div>

        </aside>


        <!-- =================================
             MAIN
        ================================== -->

        <main class="main">

            <!-- Main header -->
            <header class="main-header">

                <div class="header-content">

                    <h1>Ask Me Anything</h1>

                    <p>No topic is off limits</p>

                </div>

            </header>


            <!-- =================================
                 CHAT
            ================================== -->

            <section class="chat">


                <!-- =================================
                     QUESTION FORM
                ================================== -->

                <form class="question-form" action="/ask" method="POST">

                    <div class="input-container">

                        <label for="question">Stil dit spørgsmål her:</label>
                        <input id="question" name="question" type="text" />

                        <button class="send-button" type="submit">
                            <span>Send</span>

                            <span class="send-icon">
                                ↑
                            </span>
                        </button>

                    </div>

                </form>

                <% if (error) { %>
                    <p role="alert"><%= error %></p>
                <% } %>

                <% for (const message of messages) { %>
                    <article class="<%= message.type %>">
                        <p><%= message.text %></p>
                    </article>
                <% } %>

                <h2>Spørgsmål fordelt på emner</h2>
                    <ul>
                        <li>Navn: <%= topicStats.navn %></li>
                        <li>Bosted: <%= topicStats.bosted %></li>
                        <li>Fritid: <%= topicStats.fritid %></li>
                    </ul>

            </section>

        </main>

    </div>

</body>
</html>